# Staff-web environment variables.
# Copy to `.env.local` for local dev. Set the same vars in Vercel project
# settings → Environment Variables for production.

# ─── Passcode gate (REQUIRED in production) ──────────────────────────────────

# The shared passcode users enter on /auth/passcode.
# Pick something at least 12 chars, mixed case + digits. Never commit this.
LOGIN_PASSCODE=

# HMAC key used to sign the auth cookie. Must be ≥32 random bytes.
# Generate one with:  openssl rand -hex 32
# Rotating this invalidates every active session, which is the intended
# behaviour for a credential leak.
AUTH_SECRET=

# ─── Tips ────────────────────────────────────────────────────────────────────
#
# - Both vars are SERVER-ONLY. Do NOT prefix with NEXT_PUBLIC_ — they must
#   never reach the client bundle.
# - In Vercel: Settings → Environment Variables → add both for Production
#   (and Preview if you want previews gated too).
# - After changing AUTH_SECRET, every existing visitor will be bounced to
#   /auth/passcode on their next request. This is the kill-switch.
